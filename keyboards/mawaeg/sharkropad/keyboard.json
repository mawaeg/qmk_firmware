{
    "manufacturer": "mawaeg",
    "keyboard_name": "Sharkropad",
    "maintainer": "mawaeg",
    "bootloader": "stm32-dfu",
    "diode_direction": "COL2ROW",
    "processor": "STM32L432",
    "url": "https://github.com/mawaeg/sharkropad",
    "usb": {
        "device_version": "1.0.0",
        "pid": "0xAFFE",
        "vid": "0x6D73"
    },
    "features": {
        "bootmagic": true,
